# ============================================
# AIReduce 后端配置示例
# 复制为 .env 后填入真实值；.env 已在 .gitignore 中，切勿提交
# ============================================

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aireduce_db
DB_CHARSET=utf8mb4

# JWT：SECRET_KEY 必须至少 32 位，生成方式 openssl rand -hex 32
SECRET_KEY=请替换为你自己的随机字符串至少32位
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 服务
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 文本长度
MAX_TEXT_LENGTH=50000
MIN_TEXT_LENGTH=10

# 连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# CORS 白名单（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI 模型（也可在后台「API配置」页写入）
BASE_URL=https://api.deepseek.com/v1
DEFAULT_MODEL=deepseek-chat
DEFAULT_TEMPERATURE=1.0
DEFAULT_MAX_TOKENS=4096
API_KEY=
